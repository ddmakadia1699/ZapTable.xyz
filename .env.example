# ── Tavexa environment ───────────────────────────────────────────────
# Copy to `.env.local` and fill in. The demo app runs with mock data even if these
# are blank; they're needed once the Supabase + AWS backend is wired.

# ── Claude (menu ingestion: PDF/photo -> structured menu) ──────────────
# Pick ONE provider. With neither set, /api/menu/parse returns a mock menu.
#
# Option A — Anthropic API directly: https://console.anthropic.com
ANTHROPIC_API_KEY=
#
# Option B — AWS Bedrock (uses model `anthropic.claude-opus-4-8`). Enable model
# access in the Bedrock console first. Credentials come from the standard AWS chain
# (env vars below, a shared profile, or an IAM role) — do NOT hardcode keys in code.
LLM_PROVIDER=                     # set to "bedrock" to use AWS Bedrock
BEDROCK_MODEL_ID=                 # optional override; default anthropic.claude-opus-4-8
# AWS creds for local dev (prefer an IAM role in production). AWS_REGION is set below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Supabase (database + auth) ─────────────────────────────────────────
# Project URL + keys from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server/Lambda only — NEVER expose to the browser
SUPABASE_JWT_SECRET=              # to verify admin JWTs in Lambda (Settings → API → JWT)

# Public (safe for the browser) — used by the frontend for Supabase Auth login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for QR code generation.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── AWS (backend: Lambda + API Gateway, hosting) ───────────────────────
AWS_REGION=ap-south-1
# The deployed API Gateway base URL the frontend calls (filled after `sam deploy`).
NEXT_PUBLIC_API_BASE_URL=

# Secret for signing table QR tokens (HMAC) so they can't be forged/enumerated.
TABLE_TOKEN_SECRET=

# ── Payments (settle directly to the restaurant; Tavexa is flat-fee SaaS) ──
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
